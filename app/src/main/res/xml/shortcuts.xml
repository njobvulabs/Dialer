<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_phone"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_phone_short"
        android:shortcutLongLabel="@string/shortcut_phone_long">
        <intent
            android:action="com.example.action.OPEN_SHORTCUT"
            android:targetPackage="com.aistudio.phone.dialer.app"
            android:targetClass="com.example.MainActivity">
            <extra android:name="shortcut_target" android:value="phone" />
        </intent>
    </shortcut>
